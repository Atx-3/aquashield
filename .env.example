# ==============================================================================
# AQUA SHIELD V2: Autonomous Ocean Intelligence System - Environment Configuration
# ==============================================================================
# Copy this file to .env and populate with deployment credentials.
# DO NOT COMMIT REAL API KEYS OR SECRETS TO SOURCE CONTROL.

# Application Server Configuration
HOST=0.0.0.0
PORT=8000

# Live AIS Data Service Credentials (Pelyr HTTPS API)
PELYR_API_KEY=
PELYR_BASE_URL=https://api.pelyr.com/v1

# Global Fishing Watch (GFW) API Credentials
GFW_API_TOKEN=

# Optional Local Voice LLM Configuration (Ollama / Qwen3)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:1.7b
